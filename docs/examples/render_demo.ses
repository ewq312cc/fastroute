(session "render_demo"
  (base_design "render_demo")
  (placement
    (resolution um 10)
    (component "R_0603"
      (place R1 200000 -100000 front 0)
    )
    (component SOIC4
      (place U1 100000 -100000 front 0)
    )
    (component HDR2
      (place J1 300000 -200000 front 0)
    )
  )
  (was_is
  )
  (routes 
    (resolution um 10)
    (parser
      (host_cad "KiCad's Pcbnew")
      (host_version "9.0.0")
    )
    (library_out 
      (padstack "Via[0-1]_600:300_um"
        (shape
          (circle F.Cu 6000 0 0)
        )
        (shape
          (circle B.Cu 6000 0 0)
        )
        (attach off)
      )
    )
    (network_out 
      (net GND
        (wire
          (path B.Cu 2500
            65759 -37207
            178071 -37207
            198267 -57403
            198267 -62597
            178135 -82729
            121294 -82729
            102248 -101775
            102248 -108125
          )
        )
        (wire
          (path F.Cu 2500
            95567 -110000
            97442 -108125
            102248 -108125
          )
        )
        (wire
          (path F.Cu 2500
            87300 -110000
            95567 -110000
          )
        )
        (via "Via[0-1]_600:300_um" 102248 -108125
        )
        (wire
          (path F.Cu 2500
            87300 -110000
            87300 -130000
            208000 -130000
            208000 -100000
          )
          (type protect)
        )
      )
      (net SIG
        (via "Via[0-1]_600:300_um" 192000 -60000
          (type protect)
        )
        (via "Via[0-1]_600:300_um" 87300 -60000
          (type protect)
        )
        (wire
          (path F.Cu 2500
            192000 -60000
            192000 -100000
          )
          (type protect)
        )
        (wire
          (path B.Cu 2500
            87300 -60000
            192000 -60000
          )
          (type protect)
        )
        (wire
          (path F.Cu 2500
            87300 -90000
            87300 -60000
          )
          (type protect)
        )
      )
      (net VCC
        (wire
          (path B.Cu 2500
            100000 -63500
            120000 -63500
          )
          (type protect)
        )
      )
    )
  )
)