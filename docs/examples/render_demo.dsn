(pcb render_demo.dsn
  (parser
    (string_quote ")
    (space_in_quoted_tokens on)
    (host_cad "KiCad's Pcbnew")
    (host_version "9.0.0")
  )
  (resolution um 10)
  (unit um)
  (structure
    (layer F.Cu (type signal) (property (index 0)))
    (layer B.Cu (type signal) (property (index 1)))
    (boundary (path pcb 0  0 0  40000 0  40000 -30000  0 -30000  0 0))
    (keepout "" (polygon F.Cu 0  30000 -2000  38000 -2000  38000 -8000  30000 -8000))
    (plane GND (polygon B.Cu 0  1000 -1000  15000 -1000  15000 -4000  1000 -4000))
    (via "Via[0-1]_600:300_um")
    (rule (width 250) (clearance 200) (clearance 200 (type default_smd)) (clearance 50 (type smd_smd)))
  )
  (placement
    (component "R_0603"
      (place R1 20000 -10000 front 0)
    )
    (component "SOIC4"
      (place U1 10000 -10000 front 0)
    )
    (component "HDR2"
      (place J1 30000 -20000 front 0)
    )
  )
  (library
    (image "R_0603"
      (outline (path signal 120  -1000 -500  1000 -500  1000 500  -1000 500  -1000 -500))
      (pin R_pad 1 -800 0)
      (pin R_pad 2 800 0)
    )
    (image "SOIC4"
      (outline (path signal 120  -2000 -1500  2000 -1500  2000 1500  -2000 1500  -2000 -1500))
      (pin S_pad 1 -1270 -1000)
      (pin S_pad 2 -1270 1000)
      (pin S_pad 3 1270 1000)
      (pin S_pad 4 1270 -1000)
    )
    (image "HDR2"
      (pin T_pad 1 0 -1270)
      (pin T_pad 2 0 1270)
    )
    (padstack R_pad (shape (rect F.Cu -400 -450 400 450)) (attach off))
    (padstack S_pad (shape (rect F.Cu -500 -300 500 300)) (attach off))
    (padstack T_pad (shape (circle F.Cu 1700)) (shape (circle B.Cu 1700)) (attach off))
    (padstack "Via[0-1]_600:300_um" (shape (circle F.Cu 600)) (shape (circle B.Cu 600)) (attach off))
  )
  (network
    (net GND (pins U1-1 R1-2 J1-1))
    (net SIG (pins U1-2 R1-1))
    (net VCC (pins U1-3 J1-2))
    (net NC (pins U1-4))
    (class kicad_default "" GND SIG VCC NC
      (circuit (use_via "Via[0-1]_600:300_um"))
      (rule (width 250) (clearance 200))
    )
  )
  (wiring
    (wire (path F.Cu 250  8730 -11000  8730 -13000  20800 -13000  20800 -10000) (net GND) (type route))
    (wire (path F.Cu 250  8730 -9000  8730 -6000) (net SIG) (type route))
    (wire (path B.Cu 250  8730 -6000  19200 -6000) (net SIG) (type route))
    (wire (path F.Cu 250  19200 -6000  19200 -10000) (net SIG) (type route))
    (via "Via[0-1]_600:300_um" 8730 -6000 (net SIG) (type route))
    (via "Via[0-1]_600:300_um" 19200 -6000 (net SIG) (type route))
    (wire (path B.Cu 250  10000 -6350  12000 -6350) (net VCC) (type route))
  )
)
