{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fastroute.invalid/hcp/chunk-v1.schema.json",
  "title": "hcp-manager text block v1",
  "description": "One block of a cached document as the index keeps it and as `hcp-manager chunk show` prints it. Everything an evidence entry needs is here: the document and its version, the page and section, the source level, the devices the document is for, and the digests of the text and of the document the block was cut from. The block id contains the first 8 digits of the document's digest: a changed document gives new ids.",
  "type": "object",
  "required": ["chunk_id", "document_id", "document_version", "level", "applies_to", "page", "ordinal", "text", "text_sha256"],
  "additionalProperties": false,
  "properties": {
    "chunk_id": { "type": "string", "pattern": "^CHK-[A-Z0-9][A-Z0-9_-]*@[0-9a-f]{8}:p[0-9]+\\.[0-9]+$" },
    "document_id": { "type": "string", "pattern": "^DOC-[A-Z0-9][A-Z0-9_-]*$" },
    "document_version": { "type": "string", "minLength": 1 },
    "level": { "enum": ["official_manual", "official_errata", "official_guide", "official_reference_design", "official_devkit", "open_board", "community"] },
    "applies_to": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "page": { "type": "integer", "minimum": 1 },
    "ordinal": { "type": "integer", "minimum": 1 },
    "section": { "type": "string" },
    "text": { "type": "string", "minLength": 1 },
    "text_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
